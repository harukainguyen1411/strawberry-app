{
  "name": "@strawberry/shadow-hunters-engine",
  "version": "1.0.0",
  "description": "Pure, deterministic rules engine for the Shadow Hunters base game",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
